# Local Docker demo defaults. Keep DEMO_MODE=true only for an isolated local demo.
POSTGRES_DB=neroute
POSTGRES_USER=neroute
POSTGRES_PASSWORD=neroute_dev
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
FRONTEND_ORIGIN=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
DEMO_MODE=true

# Vercel + Supabase production settings (configure these in Vercel, not in a public file)
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<transaction-pooler-host>:6543/postgres
# JWT_SECRET=<unique-long-random-secret>
# DEMO_MODE=false
# INITIAL_ADMIN_EMAIL=admin@example.gov.in
# INITIAL_ADMIN_PASSWORD=<one-time-strong-password>
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<server-only-secret>
# SUPABASE_STORAGE_BUCKET=incident-media
